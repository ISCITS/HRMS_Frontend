APP_NAME=HRMS Backend
APP_VERSION=1.0.0
DEBUG=false
DEBUG_MODE=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Feature toggles control whether middleware and integrations enter the runtime request flow.
ENABLE_SSO=true
ENABLE_REDIS=false
ENABLE_RATE_LIMIT=false
ENABLE_AUTH_MIDDLEWARE=true
ENABLE_REQUEST_LOGGING=true
ENABLE_CORS=true
ENABLE_SWAGGER=true
ENABLE_CSRF_PROTECTION=true
ENABLE_PAYLOAD_ENCRYPTION=true

# Database settings feed the SQLAlchemy engine used by repositories.
DATABASE_HOST=192.168.0.37
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=P@ssw0rd
DATABASE_NAME=postgres
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/hrms

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
# REDIS_URL=redis://redis:6379/0

# Entra ID settings drive bearer token signature and claim validation.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AZURE_JWKS_URL=https://login.microsoftonline.com/common/discovery/v2.0/keys

ALLOWED_ORIGINS=http://localhost:3000
HRMS_CSRF_SECRET_KEY=zE8nLiA0tePsr686Jp6idRKhjpOfH0rPuYcVoJyPUUn=
SESSION_TIMEOUT_MINUTES=60

# CORS settings govern how browser-based frontend clients can call this API.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
