APP_NAME=HRMS Backend
APP_VERSION=1.0.0
DEBUG=false
DEBUG_MODE=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Keep SSO off for local Docker startup unless you already have valid Entra ID settings.
ENABLE_SSO=false
ENABLE_REDIS=true
ENABLE_RATE_LIMIT=false
ENABLE_AUTH_MIDDLEWARE=false
ENABLE_REQUEST_LOGGING=true
ENABLE_CORS=true
ENABLE_SWAGGER=true
ENABLE_CSRF_PROTECTION=true
ENABLE_PAYLOAD_ENCRYPTION=true

# These values match docker-compose service names.
DATABASE_HOST=192.168.0.37
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=P@ssw0rd
DATABASE_NAME= hrms
DATABASE_URL=postgresql+psycopg://postgres:P%40ssw0rd@192.168.0.37:5433/hrms

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# Fill these only when enabling SSO.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_ISSUER=
AZURE_JWKS_URL=

ALLOWED_ORIGINS=http://localhost:3000
HRMS_CSRF_SECRET_KEY=zE8nLiA0tePsr686Jp6idRKhjpOfH0rPuYcVoJyPUUn=
SESSION_TIMEOUT_MINUTES=60
PAYLOAD_ENCRYPTION_KEY=12345678901234567890123456789012
PAYLOAD_ENCRYPTION_IV=1234567890123456
PASSWORD_SECRET_KEY=abcdefghijklmnopqrstuvwxyz123456
PASSWORD_SECRET_IV=1234567890abcdef

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
