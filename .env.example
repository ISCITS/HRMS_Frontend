# Backend API origin. Same-origin requests are used when left empty.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Deployment base path (subpath) this app is hosted under.
# Empty/unset = hosted at the domain root, e.g. https://example.com/
# Non-empty   = hosted under a subpath, e.g. https://example.com/example/
# Set this to the SAME value the reverse proxy/ingress routes to this app under.
# Do not put environment-specific names (Testing, UTE, Staging, ...) anywhere
# else in the code - this is the only place the subpath is configured.
NEXT_PUBLIC_BASE_PATH=

# Must match HRMS_Backend/.env exactly - backend has ENABLE_PAYLOAD_ENCRYPTION=true,
# so a mismatch here breaks every encrypted API call, not just login.
NEXT_PUBLIC_PAYLOAD_ENCRYPTION_KEY=00000000000000000000000000000000
NEXT_PUBLIC_PAYLOAD_ENCRYPTION_IV=0000000000000000
NEXT_PUBLIC_PASSWORD_SECRET_KEY=00000000000000000000000000000000
NEXT_PUBLIC_PASSWORD_SECRET_IV=0000000000000000

# Backend has ENABLE_CSRF_PROTECTION=false locally, so this isn't enforced yet,
# but kept in sync with HRMS_Backend/.env in case that's turned on.
NEXT_PUBLIC_CSRF_SECRET_KEY=replace-with-a-generated-secret

# Optional: default tenant UUID used when no tenant hint is present.
NEXT_PUBLIC_DEFAULT_TENANT_UUID=

# Origin this app is reachable at (used for a handful of server-side proxy
# calls that need to state their own Origin to the backend).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
